# Local defaults; environment variables override these. Copy to `.env`.
LLM_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the host
LLM_API_KEY=ollama                                   # ignored by Ollama, required by the client
LLM_MODEL=qwen3.8:27b
LLM_TEMPERATURE=0
LOG_LEVEL=info

# Optional: enable LangSmith tracing for the "observability" path.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=multi-dev-agent
